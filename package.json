{
  "name": "officekithr-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright TypeScript POM test suite for officekithr.net",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium --grep-invert @mutating",
    "test:ci": "playwright test --project=chromium --grep-invert @mutating",
    "test:list": "playwright test --project=chromium --list",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test unit/**/*.test.ts",
    "process:results": "tsx scripts/process-results.ts",
    "process:jira": "tsx scripts/process-jira.ts",
    "send:email": "tsx scripts/send-email.ts",
    "webhook": "tsx webhook/jiraWebhook.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:workflows": "tsx scripts/validate-workflows.ts",
    "test:headed": "node run-tests.js --project=headed --sleep=3000",
    "test:headed:slow": "node run-tests.js --project=headed --sleep=5000",
    "test:headless": "playwright test --project=chromium",
    "test:dashboard": "playwright test dashboard.spec.ts --project=chromium",
    "test:dashboard:headed": "node run-dashboard-tests.js --project=headed --sleep=3000",
    "test:dashboard:headed:slow": "node run-dashboard-tests.js --project=headed --sleep=5000",
    "test:user-dashboard": "playwright test user-dashboard.spec.ts --project=chromium",
    "test:user-dashboard:headed": "node run-user-dashboard-tests.js --project=headed --sleep=3000",
    "test:user-dashboard:headed:slow": "node run-user-dashboard-tests.js --project=headed --sleep=5000",
    "test:calendar": "playwright test calendar.spec.ts --project=chromium",
    "test:calendar:headed": "node run-calendar-tests.js --project=headed --sleep=3000",
    "test:calendar:headed:slow": "node run-calendar-tests.js --project=headed --sleep=5000",
    "test:separation": "playwright test separation.spec.ts --project=chromium",
    "test:financial-requests": "playwright test financial-requests.spec.ts --project=chromium",
    "test:my-profile": "playwright test --project=chromium --grep @my-profile --grep-invert @mutating",
    "test:my-profile:p0": "playwright test --project=chromium --grep \"@my-profile.*\\[P0\\]|\\[P0\\].*@my-profile\"",
    "test:my-profile:mutating": "playwright test --project=chromium --grep \"@my-profile.*@mutating|@mutating.*@my-profile\"",
    "test:performance-demo-data": "playwright test src/tests/performance-demo-data.spec.ts --project=chromium --grep @performance-demo-data",
    "test:debug": "playwright test --debug",
    "test:login": "tsx scripts/run-login.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "pom",
    "officekithr"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "nodemailer": "^10.0.10",
    "yaml": "^2.9.1"
  }
}
